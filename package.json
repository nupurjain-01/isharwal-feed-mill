{
  "name": "isharwal-feed-mill-gate-entry",
  "version": "1.0.0",
  "description": "Windows Desktop Application for Isharwal Feed Mill Gate Entry Management System",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server/server.js",
    "build": "cd client && npm install && npm run build && cd ../server && npm install",
    "electron:start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.isharwalfeedmill.gateentry",
    "productName": "Isharwal Feed Mill Gate Entry Management System",
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "server/node_modules",
        "to": "resources/app/server/node_modules"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Isharwal Feed Mill Gate Entry"
    }
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
